{
  "credentials": [
    {
      "name": "GitHub webhook secret",
      "type": "crypto",
      "data": { "hmacSecret": "github/webhook-secret" }
    },
    {
      "name": "Alerta key",
      "type": "httpHeaderAuth",
      "data": { "name": { "literal": "X-API-Key" }, "value": "alerta/n8n-key" }
    },
    {
      "name": "Paperclip Fix CI trigger",
      "type": "httpBearerAuth",
      "data": { "token": "paperclip-triggers/fix-ci/secret" }
    }
  ]
}
