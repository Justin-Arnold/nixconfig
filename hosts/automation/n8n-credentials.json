{
  "credentials": [
    {
      "name": "GitHub webhook secret",
      "type": "crypto",
      "data": { "hmacSecret": "github/webhook-secret" }
    },
    {
      "name": "Alerta key",
      "type": "httpHeaderAuth",
      "data": {
        "name": { "literal": "X-API-Key" },
        "value": "alerta/n8n-key",
        "allowedHttpRequestDomains": { "literal": "domains" },
        "allowedDomains": { "literal": "10.118.0.1" }
      }
    },
    {
      "name": "Paperclip Fix CI trigger",
      "type": "httpBearerAuth",
      "data": {
        "token": "paperclip-triggers/fix-ci/secret",
        "allowedHttpRequestDomains": { "literal": "domains" },
        "allowedDomains": { "literal": "paperclip-triggers.servicestack.xyz" }
      }
    }
  ]
}
