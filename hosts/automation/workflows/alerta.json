    {
      "id": "14c0ed14-e3c8-42b0-9175-3d59c981603c",
      "name": "Eligible?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        1760,
        100
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "f0626512-bfe5-4055-9db9-8fc40fbf9283",
              "leftValue": "={{ /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test($json.id || '') ? 'yes' : 'no' }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "e6b7b549-87e3-4cd8-89a6-1c369a9adaf9",
              "leftValue": "={{ ['critical', 'major', 'minor', 'warning'].includes($json.severity) ? 'yes' : 'no' }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "05c30c08-ce48-425b-a343-11ebd291a7b7",
              "leftValue": "={{ !['agent-watch', 'n8n', 'send-test-alert.sh'].includes($json.origin) ? 'yes' : 'no' }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "27b4929c-1f5f-4373-b1ef-7889967c7c7b",
              "leftValue": "={{ !($json.origin === 'uptimekuma' && $json.event === 'msg') ? 'yes' : 'no' }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "47d0c5cd-4bd3-43fb-88c6-a3cd7a6a7a90",
              "leftValue": "={{ !($json.attributes?.n8nTriagedAt && new Date($json.attributes.n8nTriagedAt) >= new Date($json.receiveTime)) ? 'yes' : 'no' }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "3d0212a9-fb08-4edf-9ad0-f647ca19f99d",
              "leftValue": "={{ !(($json.history || []).filter(h => ['new', 'severity', 'status'].includes(h.type) && h.status === 'open' && new Date(h.updateTime) > new Date(Date.now() - 3600e3)).length >= 3 && $json.attributes?.n8nTriagedAt && new Date($json.attributes.n8nTriagedAt) > new Date(Date.now() - 3600e3)) ? 'yes' : 'no' }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "cad4af90-c34e-4a99-aba9-66dddfdab363",
      "name": "Batch key",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        1980,
        100
      ],
      "executeOnce": true,
      "parameters": {
        "action": "hash",
        "type": "SHA256",
        "dataPropertyName": "key",
        "encoding": "hex",
        "value": "={{ $('Eligible?').all().map(i => i.json.id + '@' + i.json.receiveTime).sort().join(' ') + ' ' + new Date().toISOString().slice(0, 13) }}"
