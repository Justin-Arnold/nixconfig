  "name": "Gneiss",
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "settings": {
        "background": "{{gneiss0}}ff",
        "foreground": "{{gneiss4}}ff"
      }
    },
    {
      "scope": "emphasis",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "strong",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "foreground": "{{gneiss-comment}}"
      }
    },
    {
      "name": "Constant Character",
      "scope": "constant.character",
      "settings": {
