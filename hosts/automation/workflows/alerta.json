        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ variables: { count: $('Eligible?').all().length, alerts: $('Eligible?').all().map(i => i.json.id).join(' ') } }) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
